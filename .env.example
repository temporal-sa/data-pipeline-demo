# Temporal Configuration

TEMPORAL_TASK_QUEUE=data-pipeline

# Optional: Payload Encryption
# Set to 'true' to enable payload encryption, 'false' or omit to disable
ENCRYPT_PAYLOADS=false

# Local Development
# If you're running a local Temporal server, you can omit the variables below
# The client will automatically connect to localhost:7233

# Required for connecting to Temporal Cloud or remote Temporal server
# TEMPORAL_HOST_URL=your-namespace.abc123.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=your-namespace.abc123

# mTLS Configuration (required for Temporal Cloud)
# Paths to your certificate files
# TEMPORAL_MTLS_TLS_CERT=/path/to/your/ca.pem
# TEMPORAL_MTLS_TLS_KEY=/path/to/your/ca.key